JOYCAPTION_MODEL=fancyfeast/llama-joycaption-beta-one-hf-llava
JOYCAPTION_MODE=AUTO
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# CPU keeps VRAM available for JoyCaption. -1 allows automatic GPU placement.
OLLAMA_NUM_GPU=0
OLLAMA_TIMEOUT=600
MAX_NEW_TOKENS=768
TEMPERATURE=0.6
TOP_P=0.9
DO_SAMPLE=false
OUTPUT_DIRECTORY=outputs
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
# Relative to the project. Model weights require about 17 GB of disk space.
HF_HOME=.cache/huggingface
# Set true AFTER downloading the model to prohibit Hugging Face network checks.
LOCAL_FILES_ONLY=false
IMAGE_MAX_SIDE=2048
IMAGE_MAX_PIXELS=40000000
CACHE_SIZE=16
